# ==============================================================================
# DAC System Environment Configuration Template (.env.example)
# NEVER commit .env containing actual secrets to version control.
# ==============================================================================

# Server & Database Configuration
PORT=5000
PGHOST=localhost
PGPORT=5432
PGUSER=ayu
PGPASSWORD=
PGDATABASE=dacexpertsys

# Supabase (Session pooler). When set, it replaces the PG* settings above.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api

# Exact browser origins allowed by the Express API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Google OAuth Credentials (for Login)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# Gemini LLM & Embeddings (Backend ONLY - Never expose to frontend)
# ==============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hindi voice translation uses Groq when GROQ_API_KEY is set (otherwise Gemini).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ==============================================================================
# Email via Gmail SMTP (Backend ONLY - Never expose to frontend)
# ==============================================================================
# Gmail account that sends the emails, and its 16-character Google App Password
# (requires 2-Step Verification; not the normal Gmail password).
SMTP_USER=
SMTP_PASS=
# Optional display sender; keep the same address as SMTP_USER.
EMAIL_FROM=DAC System <your.account@gmail.com>
# Optional: defaults are smtp.gmail.com and 465 (SSL).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Recipient of the Admin "Email Test" page.
EMAIL_TEST_TO=

# ==============================================================================
# Evidence storage: Supabase Storage (Backend ONLY - Never expose to frontend)
# ==============================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key "sb_secret_..." (Project Settings -> API Keys). It bypasses all access rules:
# keep it secret. (The legacy service_role key also works as SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=
# Private bucket for evidence files (default: evidence)
SUPABASE_EVIDENCE_BUCKET=evidence

# RAG & Vector Retrieval Settings
RAG_TOP_K=5
RAG_MIN_SCORE=0.50
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=200
